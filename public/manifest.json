{
  "name": "3am Journal",
  "short_name": "3am",
  "description": "Track sleep, training, tasks and spending. Everything you log is saved on your device and synced to your account.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "orientation": "any",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add an expense",
      "short_name": "Add expense",
      "description": "Jump straight to expense entry",
      "url": "/expenses?quick=1",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Today's tasks",
      "short_name": "Tasks",
      "description": "Tick today's list off",
      "url": "/widget/tasks",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Training streak",
      "short_name": "Training",
      "description": "Streak, weekly minutes and a quick log",
      "url": "/widget/training",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Spending summary",
      "short_name": "Spending",
      "description": "Budget and pace for the month",
      "url": "/widget/spending",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false
}
